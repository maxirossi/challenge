generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String
  lastName    String
  email       String   @unique
  user        String   @unique
  password    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  modifiedAt  DateTime? @updatedAt

  @@map("users")
}

model Driver {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  name       String
  lastName   String
  email      String   @unique
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  cars       Car[]
  trips      Trip[]

  @@map("drivers")
}

model Passenger {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  name       String
  lastName   String
  email      String   @unique
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  trips      Trip[]

  @@map("passengers")
}

model Trip {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  origin       String
  destination  String
  status       TripStatus
  fare         Float
  driverId     Int
  passengerId  Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  completedAt  DateTime?
  cancelledAt  DateTime?

  driver       Driver      @relation(fields: [driverId], references: [id])
  passenger    Passenger   @relation(fields: [passengerId], references: [id])
  invoice      Invoice?

  @@map("trips")
}

model Car {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  driverId   Int
  plate      String   @unique
  brand      String
  model      String
  year       Int
  color      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  driver     Driver   @relation(fields: [driverId], references: [id])

  @@map("cars")
}

model Invoice {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  tripId    Int      @unique
  amount    Float
  issuedAt  DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id])

  @@map("invoices")
}

enum TripStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
