{
    "name": "mate",
    "version": "0.0.1",
    "description": "A boilerplate for TS DDD Clean Code Project",
    "main": "dist/index.js",
    "scripts": {
        "start:dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register' src/index.ts",
        "dev": "ts-node -r tsconfig-paths/register src/index.ts",
        "test": "NODE_ENV=test ts-node -r tsconfig-paths/register ./node_modules/jest/bin/jest.js",
        "lint": "prettier --write src/**/*.ts{,x}",
        "build": "npm run build:clean && npm run build:tsc && npm run build:copy-swagger",
        "build:copy-swagger": "cp src/swagger_output.json dist/",
        "build:tsc": "tsc -p tsconfig.prod.json",
        "build:clean": "rm -rf dist || rmdir /s /q dist",
        "test:unit": "NODE_ENV=test jest",
        "eslint": "eslint .",
        "eslint:fix": "eslint --fix ."
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "author": "Maximiliano Rossi",
    "license": "MIT",
    "engines": {
        "node": "^18.0.0",
        "npm": ">=9.0.0"
    },
    "dependencies": {
        "@prisma/client": "^6.8.2",
        "@types/bcrypt": "^5.0.0",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/uuid": "^9.0.7",
        "axios": "^1.6.5",
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "dotenv": "^8.6.0",
        "errorhandler": "^1.5.1",
        "express": "^4.18.2",
        "express-promise-router": "^4.1.1",
        "http-status": "^1.7.3",
        "kafkajs": "^2.2.4",
        "swagger-autogen": "^2.23.7",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "uuid": "^9.0.1",
        "uuid-validate": "0.0.3",
        "winston": "^3.3.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.12",
        "@types/errorhandler": "1.5.0",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/node": "^18.19.32",
        "@types/supertest": "^6.0.2",
        "@types/uuid-validate": "0.0.1",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "eslint": "^8.56.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "husky": "^9.0.10",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.2",
        "nodemon": "^2.0.7",
        "prettier": "^3.2.1",
        "prisma": "^6.8.2",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^1.1.6",
        "typescript": "^5.8.3"
    },
    "lint-staged": {
        "{src}/**/*.ts": [
            "prettier --write",
            "git add"
        ]
    }
}
